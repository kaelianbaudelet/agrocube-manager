NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://workshop:workshop@localhost:5433/workshop
# Origines autorisees (CORS). Plusieurs separees par des virgules, ou "*" pour tout autoriser.
# Ajoute l'IP du reseau pour acceder au dashboard depuis un autre appareil :
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.10:5173
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
SCHEDULER_TZ=Europe/Paris
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-00
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too-00
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Assistant IA (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=true
